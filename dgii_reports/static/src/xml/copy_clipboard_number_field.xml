<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve" inherit_id="web.assets_backend" xmlns:owl="http://www.odoo.com/owl">
    
    <t t-name="dgii_reports.CopyClipboardNumberField" owl="1">
        <div class="d-flex align-items-center gap-2">
            <span><t t-esc="props.value"/></span>
            <button t-on-click.prevent.stop="copyToClipboard" class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-copy"/>
            </button>
        </div>
    </t>

</templates>
