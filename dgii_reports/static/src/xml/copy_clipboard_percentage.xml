<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve" inherit_id="web.assets_backend">
    <t t-name="dgii_reports.CopyClipboardPercentageField" owl="1">
        <div class="d-flex align-items-center gap-2">
            <span><t t-esc="(value * 100).toFixed(2)"/>%</span>
            <button t-on-click.prevent.stop="copyToClipboard" t-att-class="getButtonClass()">
                <i class="fa fa-copy"/>
            </button>
        </div>
    </t>
</templates>
