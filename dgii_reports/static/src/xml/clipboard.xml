<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="CopyClipboardButtonCustom" owl="1">
        <button
            type="button"
            class="btn btn-outline-secondary btn-sm"
            data-bs-toggle="tooltip"
            data-bs-placement="top"
            t-on-click="(ev) => { ev.stopPropagation(); copyToClipboard(props.value, ev); }"
        >
        <!-- t-att-title="state.copied ? 'Copied!' : 'Copy'" -->
            <i class="fa fa-copy"/>
        </button>
    </t>

    <t t-name="CopyClipboardMonetary" owl="1">
        <div class="d-flex align-items-center gap-2">
            <t t-call="web.MonetaryField"/>
            <t t-call="CopyClipboardButtonCustom"/>
        </div>
    </t>

    <t t-name="CopyClipboardPercentage" owl="1">
        <div class="d-flex align-items-center gap-2">
            <t t-call="web.PercentageField"/>
            <t t-call="CopyClipboardButtonCustom"/>
        </div>
    </t>

    <t t-name="CopyClipboardInteger" owl="1">
        <div class="d-flex align-items-center gap-2">
            <t t-call="web.IntegerField"/>
            <t t-call="CopyClipboardButtonCustom"/>
        </div>
    </t>
</templates>
