<odoo>

    <!-- VIEWS: "Res Parter"

        - Model·········: res_partner
        - Base Addons···: contacts    
    - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

    <!-- Form view for "res_partner" -->
    <record id="view_res_partner_form" model="ir.ui.view">
        <field name="name">view.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@id='company']" position="attributes">
                <attribute name="required">type == 'contact'</attribute>
                <!--TODO: Result from 'attrs' -> 'invisible' conversion without also overriding 'states' attribute
                     Check if this field tag contained a states attribute in any of the parent views, in which case it should be combined into this 'invisible' attribute
                     (If any states attributes existed in parent views, they'll also be marked with a TODO)-->
                <attribute name="invisible">country_id == 'DO' or not is_company</attribute>
                <!--TODO: Result from converting 'attrs' attribute override without options for ['readonly', 'column_invisible'] to separate attributes
                     Remove redundant empty tags below for any of those attributes that are not present in the field tag in any of the parent views
                     If someone later adds one of these attributes in the parent views, they would likely be unaware it's still overridden in this view, resulting in unexpected behaviour, which should be avoided-->
                <attribute name="readonly"/>
                <attribute name="column_invisible"/>
            </xpath>

            <xpath expr="//field[@id='individual']" position="attributes">
                <attribute name="required">type == 'contact'</attribute>
                <!--TODO: Result from 'attrs' -> 'invisible' conversion without also overriding 'states' attribute
                     Check if this field tag contained a states attribute in any of the parent views, in which case it should be combined into this 'invisible' attribute
                     (If any states attributes existed in parent views, they'll also be marked with a TODO)-->
                <attribute name="invisible">country_id == 'DO' or is_company</attribute>
                <!--TODO: Result from converting 'attrs' attribute override without options for ['readonly', 'column_invisible'] to separate attributes
                     Remove redundant empty tags below for any of those attributes that are not present in the field tag in any of the parent views
                     If someone later adds one of these attributes in the parent views, they would likely be unaware it's still overridden in this view, resulting in unexpected behaviour, which should be avoided-->
                <attribute name="readonly"/>
                <attribute name="column_invisible"/>
            </xpath>

            <xpath expr="//field[@id='individual']" position="after">
                <field id="company" class="text-break" name="name" default_focus="1" placeholder="e.g. Lumber Inc or RNC e.g. NNNNNNNNN" required="type == 'contact'" invisible="country_id != 'DO' or not is_company"/>
                <field id="individual" class="text-break" name="name" default_focus="1" placeholder="e.g. Brandom Freeman or Cedula e.g. NNNNNNNNNNN" required="type == 'contact'" invisible="country_id != 'DO' or is_company"/>
            </xpath>

        </field>
    </record>


</odoo>